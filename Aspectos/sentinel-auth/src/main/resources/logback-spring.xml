<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/seguridad_audit.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="SecuritySentinel" level="WARN">
        <appender-ref ref="FILE" />
    </logger>
</configuration>
